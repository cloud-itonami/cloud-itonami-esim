{:paths ["src"]
 ;; langgraph-clj brings langchain-clj transitively (both zero-/single-dep, all
 ;; .cljc -> portable to JVM / SCI / ClojureScript / GraalVM).
 ;;
 ;; kotoba-lang/esim is the RECORDS AND REACHABILITY AUTHORITY for this actor:
 ;; identifier structure (EID / ICCID), the profile lifecycle state machine, and
 ;; the host ports. This actor deliberately holds NO second copy of those rules.
 ;; See README `Why the library is the authority` -- the sibling card-issuing
 ;; actor reimplemented Luhn locally instead of delegating to kotoba-lang/card,
 ;; and its lifecycle allowlist had to be mirrored into the library after the
 ;; fact; starting from the library avoids both.
 ;;
 ;; The :local/root paths only resolve inside the monorepo checkout; a standalone
 ;; fork should override them with git coordinates.
 :deps {io.github.com-junkawasaki/langgraph-clj
        {:local/root "../../kotoba-lang/langgraph"}
        io.github.kotoba-lang/esim
        {:local/root "../../kotoba-lang/esim"}}
 :aliases
 {;; offline workspace dev -- pin transitive langchain-clj to local checkout
  :dev {:override-deps
        {io.github.com-junkawasaki/langchain-clj
         {:local/root "../../kotoba-lang/langchain"}}}
  ;; clojure -M:dev:run  -> drive the demo through one OperationActor
  :run {:main-opts ["-m" "esimprovisioning.sim"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; static analysis -- clj-kondo from deps (no binary), errors fail CI.
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test"
                        "--fail-level" "error"]}}}
