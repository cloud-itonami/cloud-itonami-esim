{:paths ["src" "resources"]
 ;; Dependencies are named by GIT COORDINATE, not :local/root.
 ;;
 ;; This repository's own README says a qualified operator can fork, deploy and
 ;; run it. That is not true of an actor whose :deps use :local/root -- tools.deps
 ;; resolves "../../kotoba-lang/langgraph" relative to the FORK's directory, so a
 ;; fork outside this monorepo cannot build a classpath at all. Measured
 ;; 2026-07-30, from a worktree one directory away:
 ;;   Error building classpath. Local lib io.github.com-junkawasaki/langgraph-clj
 ;;   not found: /private/kotoba-lang/langgraph
 ;; Same defect and same fix as kotoba-lang/{card,phone,esim} the same day.
 ;;
 ;; langgraph-clj brings langchain-clj transitively (both zero-/single-dep, all
 ;; .cljc). kotoba-lang/esim is the records-and-reachability authority; this actor
 ;; holds no second copy of its rules.
 :deps {
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       io.github.com-junkawasaki/langgraph-clj
        {:git/url "https://github.com/kotoba-lang/langgraph.git"
         :git/sha "577a59a9d5eb3ef90b81342f4673973f481ff7f4"}
        io.github.kotoba-lang/esim
        {:git/url "https://github.com/kotoba-lang/esim.git"
         :git/sha "7bfa343adad0c60282c5fde104e45c083d1df57d"}
        ;; The HTTP surface's JSON codec. com.sun.net.httpserver is JDK-provided,
        ;; so the server itself needs no dependency.
        ;;
        ;; Pinned as an explicit floor (tools.deps takes the NEWEST sha it is
        ;; shown): io.github.kotoba-lang/json's json.data-json namespace is a
        ;; clojure.data.json-shaped shim (read-str/write-str/read, :key-fn
        ;; applied recursively) over json.core.
        io.github.kotoba-lang/json {:git/sha "4e33e06b4d66b365d27a51393a16a0acd660f9be"}}
 :aliases
 {;; Sibling checkouts for monorepo development. The coordinate is
  ;; io.github.kotoba-lang/langchain because that is what langgraph's own
  ;; deps.edn declares -- the previous override named
  ;; io.github.com-junkawasaki/langchain-clj, which matched nothing and was
  ;; therefore a no-op.
  :dev {:override-deps
        {io.github.com-junkawasaki/langgraph-clj {:local/root "../../kotoba-lang/langgraph"}
         io.github.kotoba-lang/langchain {:local/root "../../kotoba-lang/langchain"}
         io.github.kotoba-lang/esim {:local/root "../../kotoba-lang/esim"}}}
  ;; clojure -M:dev:run  -> drive the demo through one OperationActor
  :run {:main-opts ["-m" "esimprovisioning.sim"]}
  ;; clojure -M:serve    -> the governed HTTP surface a consent surface hands to
  :serve {:main-opts ["-m" "esimprovisioning.http"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test"
                        "--fail-level" "error"]}}}
